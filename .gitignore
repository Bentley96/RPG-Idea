# Unity 6

# Editor-generated folders — never committed
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store and package caches
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Generated IDE / solution files — Unity regenerates these
.vs/
.idea/
.vscode/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash reports and build artefacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Test output
[Tt]est[Rr]esults.xml

# OS cruft
.DS_Store
Thumbs.db

# Local-only config
*.local.json

# Never ignore .meta files — a missing .meta silently breaks references
!*.meta
